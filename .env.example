DATABASE_URL=postgresql://localhost:5432/ocec_portal
PORT=3001
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Google accounts allowed into /portal-admin; use commas for multiple addresses.
ADMIN_EMAILS=
# Optional overrides for Google Drive integration; login credentials are reused when these are blank.
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=
GOOGLE_INTEGRATION_REDIRECT_URI=http://localhost:3001/api/admin/google-workspace/callback
# Generate with: openssl rand -base64 32. Keep this stable anywhere the same encrypted token database is used.
GOOGLE_INTEGRATION_ENCRYPTION_KEY=
# Set to true only when connecting to a PostgreSQL server that requires TLS.
DATABASE_SSL=false
# Build the app against PostgreSQL and the real API.
VITE_BACKEND_ENABLED=true
